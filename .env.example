PORT=4000
NODE_ENV=development
PGHOST=localhost
PGPORT=55432
PGDATABASE=dnd_hub
PGUSER=postgres
PGPASSWORD=postgres
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_ACCESS_EXPIRES_IN=7d

# Адрес фронтенда — используется в ссылках писем (подтверждение почты, сброс пароля)
# и как цель редиректа после входа через Google/VK.
FRONTEND_URL=http://127.0.0.1:8000

# ── Почта (T3.1) ─────────────────────────────────────────────────────────────
# Пока строки закомментированы, работает dev-режим: письма сохраняются файлами
# в var/outbox/ вместо реальной отправки. Чтобы включить настоящую отправку,
# раскомментируйте и заполните — пошагово: docs/email-setup.md.
# SMTP_HOST=smtp.yandex.ru          # или smtp.resend.com — см. инструкцию
# SMTP_PORT=465                     # 465 (SSL) или 587 (STARTTLS)
# SMTP_USER=you@yandex.ru           # логин почтового ящика (или "resend")
# SMTP_PASS=пароль_приложения       # НЕ обычный пароль — пароль приложения / API-ключ
# MAIL_FROM=DnD-Hub <you@yandex.ru> # адрес отправителя; у Яндекса должен совпадать с SMTP_USER

# ── Вход через Google и VK ID (T3.4) ─────────────────────────────────────────
# Пока строки закомментированы, кнопок «Войти через …» на сайте нет.
# Ключи создаются в Google Cloud Console и id.vk.com — пошагово: docs/oauth-setup.md.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# VKID_CLIENT_ID=12345678
# VKID_CLIENT_SECRET=...
# Адрес бэкенда, каким его видит браузер (на него провайдер вернёт пользователя).
# Локально: http://localhost:4000; на проде: https://ваш-домен
# OAUTH_CALLBACK_BASE=http://localhost:4000

# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
